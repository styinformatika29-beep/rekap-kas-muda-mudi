{
  "version": 3,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "kas-baru-new.html", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
